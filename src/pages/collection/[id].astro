---
// src/pages/collection/[id].astro
import Layout from '../../layouts/Layout.astro';
import { api } from '../../lib/api';
import CollectionBreadcrumb from '../../components/collection/CollectionBreadcrumb.astro';
import CollectionInfo from '../../components/collection/CollectionInfo.astro';
import SubCollections from '../../components/collection/SubCollections.astro';
import ItemsGrid from '../../components/collection/ItemsGrid.astro';

export const prerender = false;

const { id } = Astro.params;
let collection;
let items = [];
let subCollections = [];
let parentCollection = null;
let error;

try {
    // Utiliser getCollectionWithRelations pour obtenir toutes les données en une fois
    const data = await api.getCollectionWithRelations(id);
    
    if (data) {
        ({ collection, items, subCollections, parentCollection } = data);
    }
} catch (err) {
    error = err;
    console.error('Error loading collection:', error);
}
---

<Layout title={collection?.['o:title'] || 'Collection'}>
    {error ? (
        <div class="error-container">
            <h2>Une erreur est survenue</h2>
            <p>{error.message}</p>
        </div>
    ) : (
        <>
            <CollectionBreadcrumb 
                parentCollection={parentCollection} 
                collection={collection}
            />
            <CollectionInfo collection={collection} />
            <SubCollections subCollections={subCollections} />
            <ItemsGrid items={items} />
        </>
    )}
</Layout>

<style>
    .error-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 2rem;
        background-color: #fff3f3;
        border: 1px solid #ffcdd2;
        border-radius: 4px;
        text-align: center;
    }
</style>