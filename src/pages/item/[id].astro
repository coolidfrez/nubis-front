---
// src/pages/item/[id].astro
import Layout from '../../layouts/Layout.astro';
import { api } from '../../lib/api';

export const prerender = false;

const { id } = Astro.params;
let item;
const manifestUrl = `https://nubis.bis-sorbonne.fr/iiif/3/${id}/manifest`;

try {
    item = await api.getItem(id);
} catch (error) {
    console.error('Error loading item:', error);
}
---

<Layout title={item?.['o:title'] || 'Item'}>
    <div class="item-container">
        <h1>{item?.['o:title']}</h1>
        
        <div class="item-content">
            <div class="viewer-side">
                <div class="mirador-wrapper">
                    <div id="mirador"></div>
                </div>
            </div>

            <div class="metadata-side">
                {item?.['dcterms:description']?.[0]?.['@value'] && (
                    <div class="metadata-section">
                        <h2>Description</h2>
                        <p>{item['dcterms:description'][0]['@value']}</p>
                    </div>
                )}
                
                {item?.['dcterms:date']?.[0]?.['@value'] && (
                    <div class="metadata-section">
                        <h2>Date</h2>
                        <p>{item['dcterms:date'][0]['@value']}</p>
                    </div>
                )}

                {item?.['dcterms:source']?.[0]?.['@value'] && (
                    <div class="metadata-section">
                        <h2>Source</h2>
                        <p>{item['dcterms:source'][0]['@value']}</p>
                    </div>
                )}
            </div>
        </div>
    </div>
</Layout>

<style>
    .item-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .item-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin: 2rem 0;
    }

    .viewer-side {
        width: 100%;
    }

    .mirador-wrapper {
        position: relative;
        width: 100%;
        height: 600px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .metadata-side {
        padding: 1rem;
    }

    .metadata-section {
        margin-bottom: 2rem;
    }

    .metadata-section h2 {
        font-size: 1.2rem;
        margin-bottom: 0.5rem;
    }

    @media (max-width: 1024px) {
        .item-content {
            grid-template-columns: 1fr;
        }
    }
</style>

<script src="https://unpkg.com/mirador@latest/dist/mirador.min.js"></script>
<script define:vars={{ manifestUrl }}>
    window.addEventListener('load', () => {
        if (typeof Mirador !== 'undefined') {
            const miradorInstance = Mirador.viewer({
                id: 'mirador',
                windows: [{
                    manifestId: manifestUrl,
                    view: 'single',
                    thumbnailNavigationPosition: 'far-bottom'
                }],
                window: {
                    allowFullscreen: true,
                    sideBarOpenByDefault: false
                }
            });
        } else {
            console.error('Mirador failed to load');
        }
    });
</script>