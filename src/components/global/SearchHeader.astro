---
// src/components/home/SearchHeader.astro

const categories = [
    { id: 'documents', label: 'DOCUMENTS', active: true },
    { id: 'manuscripts', label: 'MANUSCRITS' },
    { id: 'photographs', label: 'PHOTOGRAPHIES' },
    { id: 'prints', label: 'ESTAMPES' },
    { id: 'printed', label: 'IMPRIMES' },
    { id: 'drawings', label: 'DESSINS' }
];
---

<div class="search-container">
    <nav class="categories-nav">
        {categories.map(category => (
            <a 
                href={`#${category.id}`} 
                class={`category-link ${category.active ? 'active' : ''}`}
            >
                {category.label}
            </a>
        ))}
    </nav>
    
    <div class="search-bar">
        <div class="search-input-wrapper">
            <button class="search-icon" aria-label="Ouvrir la recherche">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
            </button>
            <input 
                type="search" 
                placeholder="Rechercher..." 
                class="search-input"
            />
        </div>
        <button class="search-button">RECHERCHER</button>
    </div>
</div>

<style>
    .search-container {
        width: 100%;
        background-color: #fff;
    }

    .categories-nav {
        display: flex;
        background-color: #000;
        padding: 0;
        margin: 0;
    }

    .category-link {
        color: #fff;
        text-decoration: none;
        padding: 1rem 2rem;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        transition: background-color 0.3s ease;
    }

    .category-link:hover {
        background-color: #333;
    }

    .category-link.active {
        background-color: #f5f5f5;
        color: #000;
    }

    .search-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 2rem;
        border-bottom: 1px solid #eee;
    }

    .search-input-wrapper {
        display: flex;
        align-items: center;
        flex: 1;
        max-width: 600px;
    }

    .search-icon {
        background: none;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
        color: #666;
    }

    .search-input {
        border: none;
        padding: 0.5rem;
        font-size: 1rem;
        width: 100%;
        outline: none;
    }

    .search-button {
        background-color: #e6dbc9;
        border: none;
        padding: 0.75rem 2rem;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .search-button:hover {
        background-color: #d6cbb9;
    }

    @media (max-width: 768px) {
        .categories-nav {
            overflow-x: auto;
            white-space: nowrap;
        }

        .category-link {
            padding: 1rem;
        }

        .search-bar {
            flex-direction: column;
            gap: 1rem;
        }

        .search-input-wrapper {
            width: 100%;
        }
    }
</style>